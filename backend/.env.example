# ---- App ----
APP_NAME=FacultyLens
INSTITUTION_NAME=Maturi Venkata Subba Rao (MVSR) Engineering College
# Shown on the privacy notice as the contact for data questions and requests (an email or office).
PRIVACY_CONTACT=the IQAC office
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
STUDENT_HASH_SALT=change-me-another-long-random-string
# Matches Osmania University-style roll numbers such as 2451-24-751-999 (college code,
# admission year, branch code, serial). Change it if your college uses another format.
ROLL_NO_REGEX=\b\d{4}-\d{2}-\d{3}-\d{3}\b
MIN_RESPONSES_FOR_DISPLAY=5
# Shared password for the synthetic demo accounts created by python -m app.seed (demo only)
DEMO_PASSWORD=facultylens-demo

# ---- Auth ----
LOGIN_RATE_LIMIT=5/minute
REFRESH_COOKIE_NAME=fl_refresh
# true when the app is served over HTTPS
COOKIE_SECURE=false
# bcrypt cost; 12 is the production default (tests use 4)
BCRYPT_ROUNDS=12

# ---- Database ----
# Local MongoDB, or a MongoDB Atlas address (mongodb+srv://user:password@cluster/...; encode special characters in the password).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=facultylens

# ---- ML (CPU only) ----
ML_MODE=light
TORCH_NUM_THREADS=4
NLP_BATCH_SIZE=16
HF_HOME=./.hf_cache
TOX_HIDE=0.70
TOX_REVIEW=0.40
ASPECT_SIM=0.35
SARC_FLAG=0.95
# The bias panel shows group comparisons only when each gender group has this many teachers
# and analysed answers in the department; below that it says the groups are too small.
BIAS_MIN_GROUP_FACULTY=3
BIAS_MIN_GROUP_ANSWERS=30

# ---- LLM (Groq free tier: https://console.groq.com/keys) ----
# Leave GROQ_API_KEY empty to run fully on the no-LLM fallback.
GROQ_API_KEY=
# llama-3.3-70b-versatile was shut down on the free tier on 2026-08-16. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# ---- Profile imports (optional) ----
# Optional: a free key from https://www.semanticscholar.org/product/api raises the shared rate limit.
S2_API_KEY=
IMPORT_TIMEOUT_SECONDS=15

# Analyse each new response in the background as it arrives
ANALYSIS_ON_SUBMIT=true
APP_VERSION=0.1.0
